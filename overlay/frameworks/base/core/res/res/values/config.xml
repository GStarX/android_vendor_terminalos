<?xml version="1.0" encoding="utf-8"?>
<!--
  TerminalOS 静态 overlay：frameworks/base 资源覆盖
  目标设备：Xiaomi MIX 2S（polaris）
  当前分支：terminalos/lineage-22.2（Android 15 / LineageOS 22.2，官方支持基线）
  仓库位置：vendor/terminalos/overlay/frameworks/base/core/res/res/values/config.xml
  生效方式：terminalos.mk 里的
      PRODUCT_PACKAGE_OVERLAYS += vendor/terminalos/overlay
  目录结构必须与目标包（frameworks/base/core/res）严格一致，否则资源不会生效。

  分支差异（已核验源码）：
    - lineage-22.2 的 frameworks/base **没有** config_allowedSupervisionRolePackages，
      也没有锁任务快捷设置的 aconfig flag（LOCK_TASK_FEATURE_QUICK_SETTINGS 直到
      lineage-23.2/Android 16 才出现）。因此本分支**不覆盖**该资源，避免出现未知资源
      导致构建失败。
    - 22.2 上"锁任务 + 顶部快捷设置"需要用最小框架补丁实现（Phase 3 评审后实施，
      见项目仓库 docs/08）；23.2 分支用标准角色路径。

  状态声明：本 overlay 尚未构建、尚未实机验证。
-->
<resources>

    <!--
      隐藏底部导航条（导航栏）。
      资源名 config_showNavigationBar 来自 AOSP frameworks/base/core/res 的
      真实资源定义，原样覆盖，不新增/猜测其他资源。

      为什么需要：TerminalOS 希望把底部空间留给终端界面，隐藏三键/系统导航栏。

      风险与待验证项（未实机验证，Phase 3 需测试手势提示条与 Quick Settings 行为）：
        - MIX 2S 没有实体导航键。把导航栏关掉之后，手势导航是否仍可用、
          手势提示条是否还能显示，必须在实机上实测；若手势导航不可用，
          设备会失去返回/主页操作入口。
        - 导航栏高度为 0 时，Quick Settings 下拉区域与状态栏手势的触控区域
          可能随之变化，需要一起验证。
        - 回滚方式：删除本文件中的这个 <bool> 条目（恢复默认值）后重新构建
          system 镜像。
    -->
    <bool name="config_showNavigationBar">false</bool>

</resources>
